<UserControl x:Class="ProjectXLR.Views.MixerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ProjectXLR.Controls"
             xmlns:v="clr-namespace:ProjectXLR.Views">
    <UserControl.Resources>
        <v:PlainLabelConverter x:Key="PlainLabel" />
        <v:SliderNumberConverter x:Key="SliderNumber" />

        <!-- Row with its divider on top, so the last row of a list has no stray line -->
        <Style x:Key="RowTop" TargetType="Border" BasedOn="{StaticResource Row}">
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>

        <!-- Input / Output tag under each slider -->
        <Style x:Key="RoleTag" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOutputChannel}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RoleTagText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Text" Value="Input" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOutputChannel}" Value="True">
                    <Setter Property="Text" Value="Output" />
                    <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One channel in the channel list -->
        <DataTemplate x:Key="ChannelRow">
            <Border Style="{StaticResource RowTop}">
                <c:AdaptiveRow>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="{Binding AssignedFaderBadge}" Style="{StaticResource RowCaption}" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       Visibility="{Binding IsAssignedToPhysicalFader, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding ChannelSubtitle}" Style="{StaticResource RowCaption}" />
                    </StackPanel>
                    <CheckBox IsChecked="{Binding IsChannelEnabled, Mode=TwoWay}" Style="{StaticResource Switch}"
                              ToolTip="Off hides this channel from Windows sound settings. It stays in this list so you can turn it back on." />
                </c:AdaptiveRow>
            </Border>
        </DataTemplate>

        <!-- One master volume row (headphones, line out) -->
        <DataTemplate x:Key="MasterRow">
            <c:AdaptiveRow>
                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource RowTitle}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Slider Minimum="0" Maximum="100" Width="150" Value="{Binding VolumePercent, Mode=TwoWay}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding VolumePercent, StringFormat={}{0}%}" Style="{StaticResource ValueText}" Width="48" TextAlignment="Center" Margin="6,0" />
                    <CheckBox IsChecked="{Binding IsMuted, Mode=TwoWay}" Style="{StaticResource MuteToggle}" />
                </StackPanel>
            </c:AdaptiveRow>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,72">
            <TextBlock Text="Mixer" Style="{StaticResource PageTitle}" />
            <TextBlock Text="The four sliders on your device, and what each one controls." Style="{StaticResource PageSubtitle}" Margin="0,3,0,18" />

            <c:AdaptiveColumns MinColumnWidth="560">

                <!-- SLIDERS -->
                <StackPanel>
                    <StackPanel Style="{StaticResource GroupHeader}">
                        <TextBlock Text="Sliders" Style="{StaticResource SectionLabel}" />
                        <c:InfoTip Text="These match the four physical sliders, left to right. Pick any channel for each one. Inputs are sounds you hear or send, like your mic or a game. Outputs set an overall volume, like your headphones." />
                    </StackPanel>
                    <Border Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding FaderSlots}" Margin="12,12,12,12">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <v:FaderGrid />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource InsetBrush}" CornerRadius="10" Padding="10,10,10,12">
                                            <StackPanel>
                                                <TextBlock Text="{Binding FaderNumberText, Converter={StaticResource SliderNumber}}" Style="{StaticResource RowCaption}"
                                                           HorizontalAlignment="Center" Margin="0,0,0,6" />
                                                <ComboBox ItemsSource="{Binding AssignableChannelOptions}"
                                                          SelectedValuePath="Channel"
                                                          SelectedValue="{Binding AssignedChannel, Mode=TwoWay}"
                                                          MinHeight="42"
                                                          ToolTip="Choose what this slider controls.">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding DisplayName, Converter={StaticResource PlainLabel}}" FontSize="12.5" TextWrapping="Wrap" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>

                                                <!-- Input / Output tag, or a one-tap way back on if the channel is off -->
                                                <Grid Margin="0,8,0,4" Height="28">
                                                    <Border Style="{StaticResource RoleTag}" ToolTip="{Binding ChannelRoleHintText}"
                                                            Visibility="{Binding IsChannelEnabled, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Style="{StaticResource RoleTagText}" />
                                                    </Border>
                                                    <Button Click="EnableFaderChannel_Click" Tag="{Binding Fader}" Style="{StaticResource Btn}"
                                                            Content="Off, turn on" Padding="10,3" HorizontalAlignment="Center"
                                                            Background="{StaticResource AmberSoftBrush}" Foreground="{StaticResource AmberBrush}"
                                                            ToolTip="{Binding DisabledHintText}"
                                                            Visibility="{Binding IsChannelDisabled, Converter={StaticResource BoolToVis}}" />
                                                </Grid>

                                                <Slider Style="{StaticResource Fader}" Height="140" Minimum="0" Maximum="100"
                                                        Value="{Binding VolumePercent, Mode=TwoWay}"
                                                        IsEnabled="{Binding IsChannelEnabled}"
                                                        HorizontalAlignment="Center" Margin="0,4" />
                                                <TextBlock Text="{Binding VolumePercent, StringFormat={}{0}%}" Style="{StaticResource ValueText}"
                                                           HorizontalAlignment="Center" Margin="0,4,0,8" ToolTip="{Binding FormattedDbLevel}" />
                                                <CheckBox IsChecked="{Binding IsMuted, Mode=TwoWay}" Style="{StaticResource MuteToggle}" HorizontalAlignment="Stretch" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Style="{StaticResource RowTop}">
                                <c:AdaptiveRow>
                                    <TextBlock Text="Quick layouts" Style="{StaticResource RowTitle}" />
                                    <WrapPanel HorizontalAlignment="Right">
                                        <Button Content="Mic, Game, Chat, Volume" Tag="GamingMaster" Click="FaderLayoutPreset_Click" Style="{StaticResource Btn}" Margin="0,0,6,0"
                                                ToolTip="Slider 1 Mic, 2 Game, 3 Voice Chat, 4 Headphones volume." />
                                        <Button Content="Mic, Desktop, Chat, Volume" Tag="Default" Click="FaderLayoutPreset_Click" Style="{StaticResource Btn}" Margin="0,0,6,0"
                                                ToolTip="Slider 1 Mic, 2 System sounds, 3 Voice Chat, 4 Headphones volume." />
                                        <Button Content="Set all to 100%" Click="SetAll100_Click" Style="{StaticResource Btn}"
                                                ToolTip="Puts every channel back to full volume." />
                                    </WrapPanel>
                                </c:AdaptiveRow>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- MASTER VOLUME -->
                <StackPanel>
                    <StackPanel Style="{StaticResource GroupHeader}">
                        <TextBlock Text="Master volume" Style="{StaticResource SectionLabel}" />
                        <c:InfoTip Text="The overall volume of what comes out of your headphones, and of speakers plugged into the Line Out jack on the back." />
                    </StackPanel>
                    <Border Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <Border Style="{StaticResource Row}">
                                <ContentControl Content="{Binding HeadphonesMasterChannel}" ContentTemplate="{StaticResource MasterRow}" IsTabStop="False" />
                            </Border>
                            <Border Style="{StaticResource RowLast}">
                                <ContentControl Content="{Binding LineOutMasterChannel}" ContentTemplate="{StaticResource MasterRow}" IsTabStop="False" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- CHANNELS -->
                <StackPanel>
                    <StackPanel Style="{StaticResource GroupHeader}">
                        <TextBlock Text="Channels" Style="{StaticResource SectionLabel}" />
                        <c:InfoTip Text="Each channel is a sound device that shows up in Windows, such as Game or Voice Chat. Turning a channel off hides it from Windows sound settings. It stays in this list, so you can always turn it back on." />
                    </StackPanel>
                    <Border Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <Border Style="{StaticResource RowLast}">
                                <c:AdaptiveRow>
                                    <StackPanel>
                                        <TextBlock Text="Show all channels" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Turned-off channels disappear from Windows sound settings." Style="{StaticResource RowCaption}" />
                                    </StackPanel>
                                    <CheckBox x:Name="ShowAllSwitch" Style="{StaticResource Switch}" IsChecked="False" />
                                </c:AdaptiveRow>
                            </Border>

                            <ItemsControl x:Name="CoreChannelsList" ItemTemplate="{StaticResource ChannelRow}" />

                            <StackPanel Visibility="{Binding IsChecked, ElementName=ShowAllSwitch, Converter={StaticResource BoolToVis}}">
                                <ItemsControl x:Name="MoreChannelsList" ItemTemplate="{StaticResource ChannelRow}" />
                                <Border Style="{StaticResource RowTop}">
                                    <WrapPanel>
                                        <Button Content="Minimal setup" Click="ResetToMinimalChannels_Click" Style="{StaticResource Btn}" Margin="0,0,6,0"
                                                ToolTip="Keeps one playback and one recording channel and hides the rest in Windows." />
                                        <Button Content="Standard channels" Click="EnableStandardChannels_Click" Style="{StaticResource Btn}" Margin="0,0,6,0"
                                                ToolTip="Turns on Mic, System, Game, Music and the stream mix." />
                                        <Button Content="Refresh Windows" Click="SyncWindowsEndpoints_Click" Style="{StaticResource Btn}" Margin="0,0,6,0"
                                                ToolTip="Makes Windows sound settings match the channels you have on." />
                                        <Button Content="Windows sound settings" Click="OpenWindowsSoundControlPanel_Click" Style="{StaticResource Btn}"
                                                ToolTip="Opens the classic Windows sound panel." />
                                    </WrapPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </c:AdaptiveColumns>
        </StackPanel>
    </ScrollViewer>
</UserControl>
