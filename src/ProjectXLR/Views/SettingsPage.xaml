<UserControl x:Class="ProjectXLR.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ProjectXLR.Controls">
    <UserControl.Resources>
        <!-- One clickable row in the profile list; the active profile is tinted and checked -->
        <Style x:Key="ProfileRow" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="16,11" MinHeight="48"
                                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,72">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Setup, saved profiles and housekeeping." Style="{StaticResource PageSubtitle}" Margin="0,3,0,18" />

            <c:AdaptiveColumns MinColumnWidth="440">

                <!-- GETTING STARTED -->
                <StackPanel>
                    <StackPanel Style="{StaticResource GroupHeader}">
                        <TextBlock Text="Getting started" Style="{StaticResource SectionLabel}" />
                    </StackPanel>
                    <Border Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <Border Style="{StaticResource Row}">
                                <c:AdaptiveRow>
                                    <StackPanel>
                                        <TextBlock Text="Quick setup" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="A short guide to your mic and headphones." Style="{StaticResource RowCaption}" />
                                    </StackPanel>
                                    <Button Content="Start" Click="OpenQuickStart_Click" Style="{StaticResource BtnAccent}" />
                                </c:AdaptiveRow>
                            </Border>
                            <Border Style="{StaticResource RowLast}">
                                <c:AdaptiveRow>
                                    <StackPanel>
                                        <TextBlock Text="Open when Windows starts" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="So your mixer is ready when you sit down." Style="{StaticResource RowCaption}" />
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding RunOnWindowsStartup, Mode=TwoWay}" Style="{StaticResource Switch}" />
                                </c:AdaptiveRow>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- PROFILES -->
                <StackPanel>
                    <StackPanel Style="{StaticResource GroupHeader}">
                        <TextBlock Text="Profiles" Style="{StaticResource SectionLabel}" />
                        <c:InfoTip Text="Click a profile to switch to it. Save changes updates the selected one; Save as new keeps the original and makes a copy." />
                    </StackPanel>
                    <Border Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <TextBlock Text="A profile saves your whole setup: sliders, voice, routing and lighting." Style="{StaticResource RowCaption}" Margin="16,12,16,10" />
                            <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0">
                                <ItemsControl ItemsSource="{Binding ProfileCards}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding Name}" Click="SelectProfile_Click" Style="{StaticResource ProfileRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource RowCaption}" />
                                                    </StackPanel>
                                                    <Path Grid.Column="1" Data="{StaticResource SfCheckmarkCircle}" Fill="{StaticResource AccentBrush}"
                                                          Width="18" Height="18" Stretch="Uniform" Margin="12,0,0,0" VerticalAlignment="Center"
                                                          Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <c:AdaptiveRow>
                                    <StackPanel>
                                        <TextBlock Text="Name for a new profile" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Used by Save as new." Style="{StaticResource RowCaption}" />
                                    </StackPanel>
                                    <TextBox Text="{Binding NewProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="200" />
                                </c:AdaptiveRow>
                            </Border>
                            <Border Style="{StaticResource RowLast}">
                                <WrapPanel>
                                    <Button Content="Save changes" Click="SaveProfile_Click" Style="{StaticResource BtnAccent}" Margin="0,0,8,6"
                                            ToolTip="Saves your tweaks into the profile that is currently selected." />
                                    <Button Content="Save as new" Click="DuplicateProfile_Click" Style="{StaticResource Btn}" Margin="0,0,8,6"
                                            ToolTip="Makes a copy of your current setup under the name above." />
                                    <Button Content="Import official profiles" Click="ImportOfficialProfiles_Click" Style="{StaticResource Btn}" Margin="0,0,8,6"
                                            ToolTip="Brings in profiles from the original GoXLR app." />
                                    <Button Content="Delete selected" Click="DeleteProfile_Click" Style="{StaticResource BtnDanger}" Margin="0,0,0,6"
                                            ToolTip="Deletes the profile that is currently selected." />
                                </WrapPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- HEADPHONES -->
                <StackPanel>
                    <StackPanel Style="{StaticResource GroupHeader}">
                        <TextBlock Text="Headphones" Style="{StaticResource SectionLabel}" />
                        <c:InfoTip Text="Pick where your headphones are plugged in: the GoXLR's 3.5mm jack, a USB DAC or a wireless headset." />
                    </StackPanel>
                    <Border Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <Border Style="{StaticResource Row}">
                                <StackPanel>
                                    <TextBlock Text="Headphone output" Style="{StaticResource RowTitle}" Margin="0,0,0,8" />
                                    <ComboBox ItemsSource="{Binding PlaybackDevices}" SelectedItem="{Binding SelectedPlaybackDevice, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" ToolTip="Where your headphones are plugged in.">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" Margin="0,3" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource RowLast}">
                                <c:AdaptiveRow>
                                    <StackPanel>
                                        <TextBlock Text="Check my audio setup" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Makes sure Windows uses the right mic and headphones." Style="{StaticResource RowCaption}" />
                                    </StackPanel>
                                    <Button Content="Check now" Click="RouteWindowsAudioToGoXlr_Click" Style="{StaticResource Btn}"
                                            ToolTip="Sets Chat Mic (with AI noise removal) as your recording device and sends sound straight to your headphones." />
                                </c:AdaptiveRow>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- AI NOISE REMOVAL -->
                <StackPanel>
                    <StackPanel Style="{StaticResource GroupHeader}">
                        <TextBlock Text="AI noise removal" Style="{StaticResource SectionLabel}" />
                        <c:InfoTip Text="Uses DeepFilterNet 3, an open-source AI noise filter. Configurator opens Equalizer APO's device picker so you can check the right mic is selected. Visualizer opens the filter's own window with a live view of your sound." />
                    </StackPanel>
                    <Border Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <Border Style="{StaticResource Row}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DeepFilterNetTitle}" Style="{StaticResource RowTitle}" FontWeight="SemiBold" Foreground="{Binding DeepFilterNetBadgeColor}" />
                                    <TextBlock Text="{Binding DeepFilterNetMessage}" Style="{StaticResource RowCaption}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource RowLast}">
                                <WrapPanel>
                                    <Button Content="{Binding DeepFilterNetActionButtonText}" Click="InstallOrRepairDeepFilterNet_Click" Style="{StaticResource Btn}" Margin="0,0,8,6" />
                                    <Button Content="Refresh" Click="RefreshDeepFilterNetStatus_Click" Style="{StaticResource Btn}" Margin="0,0,8,6"
                                            ToolTip="Checks the current status again." />
                                    <Button Content="Configurator" Click="OpenDeepFilterNetConfigurator_Click" Style="{StaticResource Btn}" Margin="0,0,8,6"
                                            Visibility="{Binding IsDeepFilterNetInstalled, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Opens Equalizer APO Configurator to check which devices are used." />
                                    <Button Content="Visualizer" Click="LaunchAltDenoiser_Click" Style="{StaticResource Btn}" Margin="0,0,0,6"
                                            ToolTip="Opens the filter's own window to see your sound live and fine-tune it." />
                                </WrapPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- OLD GOXLR APP -->
                <StackPanel Visibility="{Binding IsLegacyGoXlrAppPresent, Converter={StaticResource BoolToVis}}">
                    <StackPanel Style="{StaticResource GroupHeader}">
                        <TextBlock Text="Old GoXLR app" Style="{StaticResource SectionLabel}" />
                        <c:InfoTip Text="XLR Studio talks to your mixer directly, so the original GoXLR app is not needed and can clash if it stays open. Do keep the GoXLR USB audio driver installed: it creates the System, Game, Chat and Mic sound devices." />
                    </StackPanel>
                    <Border Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <Border Style="{StaticResource Row}">
                                <StackPanel>
                                    <TextBlock Text="You don't need it anymore" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{Binding LegacyGoXlrStatusText}" Style="{StaticResource RowCaption}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource RowLast}">
                                <WrapPanel>
                                    <Button Content="Close it" Click="KillLegacyGoXlr_Click" Style="{StaticResource Btn}" Margin="0,0,8,6"
                                            ToolTip="Closes any old GoXLR app still running in the background." />
                                    <Button Content="Uninstall..." Click="OpenWindowsApps_Click" Style="{StaticResource Btn}" Margin="0,0,0,6"
                                            ToolTip="Opens Windows installed apps so you can remove the old GoXLR app." />
                                </WrapPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- WINDOWS SOUND -->
                <StackPanel>
                    <StackPanel Style="{StaticResource GroupHeader}">
                        <TextBlock Text="Windows sound" Style="{StaticResource SectionLabel}" />
                    </StackPanel>
                    <Border Style="{StaticResource GroupCard}">
                        <Border Style="{StaticResource RowLast}">
                            <c:AdaptiveRow>
                                <StackPanel>
                                    <TextBlock Text="Sound settings" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Opens the classic Windows sound window." Style="{StaticResource RowCaption}" />
                                </StackPanel>
                                <Button Content="Open" Click="OpenWindowsSoundControlPanel_Click" Style="{StaticResource Btn}" />
                            </c:AdaptiveRow>
                        </Border>
                    </Border>
                </StackPanel>

                <!-- EXIT -->
                <StackPanel>
                    <StackPanel Style="{StaticResource GroupHeader}">
                        <TextBlock Text="Quit" Style="{StaticResource SectionLabel}" />
                        <c:InfoTip Text="Closing the window with X keeps XLR Studio running in the system tray so your sliders and monitoring keep working in games. Quit stops it completely and hands Windows sound back to your headphones." />
                    </StackPanel>
                    <Border Style="{StaticResource GroupCard}">
                        <Border Style="{StaticResource RowLast}">
                            <c:AdaptiveRow>
                                <StackPanel>
                                    <TextBlock Text="Exit XLR Studio" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Closing the window only hides it in the tray." Style="{StaticResource RowCaption}" />
                                </StackPanel>
                                <Button Content="Exit" Click="ExitApp_Click" Style="{StaticResource BtnDanger}"
                                        ToolTip="Completely quits and gives Windows sound back to your headphones." />
                            </c:AdaptiveRow>
                        </Border>
                    </Border>
                </StackPanel>
            </c:AdaptiveColumns>
        </StackPanel>
    </ScrollViewer>
</UserControl>
