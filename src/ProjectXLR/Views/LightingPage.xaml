<UserControl x:Class="ProjectXLR.Views.LightingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ProjectXLR.Controls"
             xmlns:v="clr-namespace:ProjectXLR.Views">
    <UserControl.Resources>
        <v:EffectMatchConverter x:Key="EffectMatch" />
        <v:LightingFriendlyConverter x:Key="LightingFriendly" />
        <v:SwatchMatchConverter x:Key="SwatchMatch" />

        <!-- Slot ring: shows which slider the color will go to. Only meaningful in Color mode. -->
        <Style x:Key="SlotRingBase" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style x:Key="SlotRingA" TargetType="Border" BasedOn="{StaticResource SlotRingBase}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsLightingCustomTab}" Value="True" />
                        <Condition Binding="{Binding IsFaderASelectedForLighting}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsLightingCustomTab}" Value="True" />
                        <Condition Binding="{Binding IsAllFadersSelectedForLighting}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SlotRingB" TargetType="Border" BasedOn="{StaticResource SlotRingBase}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsLightingCustomTab}" Value="True" />
                        <Condition Binding="{Binding IsFaderBSelectedForLighting}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsLightingCustomTab}" Value="True" />
                        <Condition Binding="{Binding IsAllFadersSelectedForLighting}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SlotRingC" TargetType="Border" BasedOn="{StaticResource SlotRingBase}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsLightingCustomTab}" Value="True" />
                        <Condition Binding="{Binding IsFaderCSelectedForLighting}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsLightingCustomTab}" Value="True" />
                        <Condition Binding="{Binding IsAllFadersSelectedForLighting}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SlotRingD" TargetType="Border" BasedOn="{StaticResource SlotRingBase}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsLightingCustomTab}" Value="True" />
                        <Condition Binding="{Binding IsFaderDSelectedForLighting}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsLightingCustomTab}" Value="True" />
                        <Condition Binding="{Binding IsAllFadersSelectedForLighting}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Clickable slot on the device picture -->
        <Style x:Key="SlotButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="Cp" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cp" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round color swatch. Background is the color, Tag is the hex code. -->
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="36" Height="36">
                            <Ellipse x:Name="Ring" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.5">
                                <Ellipse.Visibility>
                                    <MultiBinding Converter="{StaticResource SwatchMatch}">
                                        <Binding Path="SelectedFaderColorChipBrush" />
                                        <Binding Path="Tag" RelativeSource="{RelativeSource TemplatedParent}" />
                                    </MultiBinding>
                                </Ellipse.Visibility>
                            </Ellipse>
                            <Ellipse x:Name="Dot" Width="26" Height="26" Fill="{TemplateBinding Background}" Stroke="#55555C" StrokeThickness="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Width" Value="29" />
                                <Setter TargetName="Dot" Property="Height" Value="29" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Selectable tile used for gradients and animations -->
        <Style x:Key="Tile" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{StaticResource ControlBrush}" BorderBrush="Transparent" BorderThickness="2" CornerRadius="10" Padding="12,10">
                            <Grid>
                                <ContentPresenter />
                                <Path x:Name="Check" Data="{StaticResource SfCheckmarkCircle}" Fill="{StaticResource AccentBrush}" Width="16" Height="16" Stretch="Uniform"
                                      HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rainbow slider for picking any color -->
        <Style x:Key="HueSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="10" CornerRadius="5" Margin="11,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF0000" Offset="0" />
                                        <GradientStop Color="#FFFF00" Offset="0.17" />
                                        <GradientStop Color="#00FF00" Offset="0.33" />
                                        <GradientStop Color="#00FFFF" Offset="0.5" />
                                        <GradientStop Color="#0000FF" Offset="0.67" />
                                        <GradientStop Color="#FF00FF" Offset="0.83" />
                                        <GradientStop Color="#FF0000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="22" Height="22" Fill="White" Stroke="#55555C" StrokeThickness="1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header text on the device card: says what the next color will change -->
        <Style x:Key="TargetTitle" TargetType="TextBlock" BasedOn="{StaticResource RowTitle}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Text" Value="All four sliders" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsLightingCustomTab}" Value="True" />
                        <Condition Binding="{Binding IsAllFadersSelectedForLighting}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Text" Value="{Binding SelectedFaderLightingTitle}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TargetCaption" TargetType="TextBlock" BasedOn="{StaticResource RowCaption}">
            <Setter Property="Text" Value="Gradients and animations use all four sliders together." />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLightingCustomTab}" Value="True">
                    <Setter Property="Text" Value="Click a slider to color just that one." />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,72">
            <TextBlock Text="Lighting" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Choose how your mixer lights up." Style="{StaticResource PageSubtitle}" Margin="0,3,0,18" />

            <!-- DEVICE PREVIEW -->
            <StackPanel Style="{StaticResource GroupHeader}">
                <TextBlock Text="Your mixer" Style="{StaticResource SectionLabel}" />
                <c:InfoTip Text="A live picture of your GoXLR. Whatever you change here changes on the real unit at the same time." />
            </StackPanel>
            <Border Style="{StaticResource GroupCard}" Padding="16,14,16,16" Margin="0,0,0,24">
                <StackPanel>
                    <c:AdaptiveRow>
                        <StackPanel>
                            <TextBlock Style="{StaticResource TargetTitle}" />
                            <TextBlock Style="{StaticResource TargetCaption}" />
                        </StackPanel>
                        <Border Style="{StaticResource SegmentedTrack}" Visibility="{Binding IsLightingCustomTab, Converter={StaticResource BoolToVis}}">
                            <UniformGrid Rows="1">
                                <RadioButton Content="All four" GroupName="LightTarget" IsChecked="{Binding IsAllFadersSelectedForLighting, Mode=OneWay}" Tag="4" Click="SelectFaderLighting_Click"
                                             Style="{StaticResource Segment}" ToolTip="Color all four sliders at once." />
                            </UniformGrid>
                        </Border>
                    </c:AdaptiveRow>

                    <Border Background="{StaticResource InsetBrush}" CornerRadius="16" Padding="12" Margin="0,14,0,0" MaxWidth="760">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <UniformGrid Rows="1" Grid.Column="0">
                                <!-- Slider 1 -->
                                <Button Tag="0" Click="SelectFaderLighting_Click" Style="{StaticResource SlotButton}" Margin="0,0,8,0" ToolTip="Choose slider 1">
                                    <Border Style="{StaticResource SlotRingA}" Padding="4,12,4,12">
                                        <StackPanel>
                                            <TextBlock Text="Slider 1" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding FaderSlots[0].ChannelDisplayName}" Style="{StaticResource RowCaption}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,1,0,10" />
                                            <Grid Height="104" Width="34" HorizontalAlignment="Center">
                                                <Border Width="8" Background="{Binding FaderABrush}" CornerRadius="4" HorizontalAlignment="Center" />
                                                <Border Width="34" Height="16" Background="#E8E8ED" CornerRadius="5" VerticalAlignment="Center">
                                                    <Border Width="16" Height="2" Background="#6E6E76" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                            <Border Height="22" Margin="6,12,6,0" MaxWidth="56" Background="{Binding FaderABrush}" CornerRadius="6" />
                                            <TextBlock Text="Mute" Style="{StaticResource RowCaption}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Button>
                                <!-- Slider 2 -->
                                <Button Tag="1" Click="SelectFaderLighting_Click" Style="{StaticResource SlotButton}" Margin="0,0,8,0" ToolTip="Choose slider 2">
                                    <Border Style="{StaticResource SlotRingB}" Padding="4,12,4,12">
                                        <StackPanel>
                                            <TextBlock Text="Slider 2" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding FaderSlots[1].ChannelDisplayName}" Style="{StaticResource RowCaption}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,1,0,10" />
                                            <Grid Height="104" Width="34" HorizontalAlignment="Center">
                                                <Border Width="8" Background="{Binding FaderBBrush}" CornerRadius="4" HorizontalAlignment="Center" />
                                                <Border Width="34" Height="16" Background="#E8E8ED" CornerRadius="5" VerticalAlignment="Center">
                                                    <Border Width="16" Height="2" Background="#6E6E76" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                            <Border Height="22" Margin="6,12,6,0" MaxWidth="56" Background="{Binding FaderBBrush}" CornerRadius="6" />
                                            <TextBlock Text="Mute" Style="{StaticResource RowCaption}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Button>
                                <!-- Slider 3 -->
                                <Button Tag="2" Click="SelectFaderLighting_Click" Style="{StaticResource SlotButton}" Margin="0,0,8,0" ToolTip="Choose slider 3">
                                    <Border Style="{StaticResource SlotRingC}" Padding="4,12,4,12">
                                        <StackPanel>
                                            <TextBlock Text="Slider 3" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding FaderSlots[2].ChannelDisplayName}" Style="{StaticResource RowCaption}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,1,0,10" />
                                            <Grid Height="104" Width="34" HorizontalAlignment="Center">
                                                <Border Width="8" Background="{Binding FaderCBrush}" CornerRadius="4" HorizontalAlignment="Center" />
                                                <Border Width="34" Height="16" Background="#E8E8ED" CornerRadius="5" VerticalAlignment="Center">
                                                    <Border Width="16" Height="2" Background="#6E6E76" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                            <Border Height="22" Margin="6,12,6,0" MaxWidth="56" Background="{Binding FaderCBrush}" CornerRadius="6" />
                                            <TextBlock Text="Mute" Style="{StaticResource RowCaption}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Button>
                                <!-- Slider 4 -->
                                <Button Tag="3" Click="SelectFaderLighting_Click" Style="{StaticResource SlotButton}" Margin="0,0,8,0" ToolTip="Choose slider 4">
                                    <Border Style="{StaticResource SlotRingD}" Padding="4,12,4,12">
                                        <StackPanel>
                                            <TextBlock Text="Slider 4" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding FaderSlots[3].ChannelDisplayName}" Style="{StaticResource RowCaption}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,1,0,10" />
                                            <Grid Height="104" Width="34" HorizontalAlignment="Center">
                                                <Border Width="8" Background="{Binding FaderDBrush}" CornerRadius="4" HorizontalAlignment="Center" />
                                                <Border Width="34" Height="16" Background="#E8E8ED" CornerRadius="5" VerticalAlignment="Center">
                                                    <Border Width="16" Height="2" Background="#6E6E76" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                            <Border Height="22" Margin="6,12,6,0" MaxWidth="56" Background="{Binding FaderDBrush}" CornerRadius="6" />
                                            <TextBlock Text="Mute" Style="{StaticResource RowCaption}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </UniformGrid>

                            <!-- Side buttons -->
                            <Border Grid.Column="1" Background="{StaticResource ControlBrush}" CornerRadius="12" Padding="10,12" Width="78" VerticalAlignment="Stretch">
                                <StackPanel VerticalAlignment="Bottom">
                                    <Border Height="26" Background="{StaticResource InsetBrush}" CornerRadius="7" ToolTip="Bleep button" />
                                    <TextBlock Text="Bleep" Style="{StaticResource RowCaption}" HorizontalAlignment="Center" Margin="0,2,0,12" />
                                    <Border Height="34" Background="{StaticResource InsetBrush}" CornerRadius="7" ToolTip="Cough button" />
                                    <TextBlock Text="Cough" Style="{StaticResource RowCaption}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource RowCaption}" Margin="0,12,0,0">
                        <Run Text="Showing now: " />
                        <Run Text="{Binding ActiveLightingSummary, Converter={StaticResource LightingFriendly}, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- STYLE PICKER -->
            <StackPanel Style="{StaticResource GroupHeader}">
                <TextBlock Text="Lighting style" Style="{StaticResource SectionLabel}" />
                <c:InfoTip Text="Color keeps things simple. Gradient gives each slider its own shade. Animation moves the colors on its own." />
            </StackPanel>
            <Border Style="{StaticResource GroupCard}">
                <StackPanel>
                    <Border Style="{StaticResource Row}">
                        <Border Style="{StaticResource SegmentedTrack}" HorizontalAlignment="Stretch">
                            <UniformGrid Rows="1">
                                <RadioButton Content="Color" GroupName="LightMode" IsChecked="{Binding IsLightingCustomTab, Mode=TwoWay}" Style="{StaticResource Segment}" ToolTip="One color for everything, or a different color per slider." />
                                <RadioButton Content="Gradient" GroupName="LightMode" IsChecked="{Binding IsLightingGradientsTab, Mode=TwoWay}" Style="{StaticResource Segment}" ToolTip="A ready-made blend of four colors across the sliders." />
                                <RadioButton Content="Animation" GroupName="LightMode" IsChecked="{Binding IsLightingAnimationsTab, Mode=TwoWay}" Style="{StaticResource Segment}" ToolTip="Lights that move by themselves." />
                            </UniformGrid>
                        </Border>
                    </Border>

                    <!-- COLOR -->
                    <StackPanel Visibility="{Binding LightingCustomTabVisibility}">
                        <Border Style="{StaticResource Row}">
                            <StackPanel>
                                <TextBlock Text="Pick a color" Style="{StaticResource RowTitle}" />
                                <WrapPanel Margin="0,10,0,-8">
                                    <Button Background="#00FFFF" Tag="00FFFF" Click="AccentColor_Click" Style="{StaticResource Swatch}" ToolTip="Cyan" />
                                    <Button Background="#0A84FF" Tag="0A84FF" Click="AccentColor_Click" Style="{StaticResource Swatch}" ToolTip="Blue" />
                                    <Button Background="#003CFF" Tag="003CFF" Click="AccentColor_Click" Style="{StaticResource Swatch}" ToolTip="Deep blue" />
                                    <Button Background="#A855F7" Tag="A855F7" Click="AccentColor_Click" Style="{StaticResource Swatch}" ToolTip="Purple" />
                                    <Button Background="#FF2D55" Tag="FF2D55" Click="AccentColor_Click" Style="{StaticResource Swatch}" ToolTip="Pink" />
                                    <Button Background="#FF1E1E" Tag="FF1E1E" Click="AccentColor_Click" Style="{StaticResource Swatch}" ToolTip="Red" />
                                    <Button Background="#FF6414" Tag="FF6414" Click="AccentColor_Click" Style="{StaticResource Swatch}" ToolTip="Orange" />
                                    <Button Background="#FFC80A" Tag="FFC80A" Click="AccentColor_Click" Style="{StaticResource Swatch}" ToolTip="Gold" />
                                    <Button Background="#30D158" Tag="30D158" Click="AccentColor_Click" Style="{StaticResource Swatch}" ToolTip="Green" />
                                    <Button Background="#00F5A0" Tag="00F5A0" Click="AccentColor_Click" Style="{StaticResource Swatch}" ToolTip="Mint" />
                                    <Button Background="#FFFFFF" Tag="FFFFFF" Click="AccentColor_Click" Style="{StaticResource Swatch}" ToolTip="White" />
                                    <Button Background="#000000" Tag="000000" Click="AccentColor_Click" Style="{StaticResource Swatch}" ToolTip="Lights off" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <StackPanel>
                                <TextBlock Text="Or slide to any color" Style="{StaticResource RowTitle}" />
                                <Slider Style="{StaticResource HueSlider}" Minimum="0" Maximum="360" Value="{Binding CustomHue, Mode=TwoWay}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource RowLast}">
                            <c:AdaptiveRow>
                                <StackPanel>
                                    <TextBlock Text="Color code" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Six letters or numbers, like FF8800." Style="{StaticResource RowCaption}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Width="28" Height="28" CornerRadius="8" Background="{Binding SelectedFaderColorChipBrush}" BorderBrush="#55555C" BorderThickness="1" VerticalAlignment="Center" ToolTip="The color you have now" />
                                    <TextBlock Text="#" Style="{StaticResource ValueText}" Foreground="{StaticResource TextSecondaryBrush}" Margin="10,0,4,0" />
                                    <TextBox Text="{Binding CustomHexInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="92" MaxLength="6" FontWeight="SemiBold" />
                                    <Button Content="Apply" Click="ApplyCustomHex_Click" Style="{StaticResource BtnAccent}" Margin="8,0,0,0" />
                                </StackPanel>
                            </c:AdaptiveRow>
                        </Border>
                    </StackPanel>

                    <!-- GRADIENT -->
                    <StackPanel Visibility="{Binding LightingGradientsTabVisibility}" Margin="14,14,14,14">
                        <c:AdaptiveColumns MinColumnWidth="200" Gap="10">
                            <RadioButton GroupName="LightGradient" Tag="Cyberpunk" IsChecked="{Binding ActiveLightingSummary, Converter={StaticResource EffectMatch}, ConverterParameter=Cyberpunk, Mode=OneWay}" Click="ApplyLightingTheme_Click" Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="Neon" Style="{StaticResource RowTitle}" Margin="0,0,22,0" />
                                    <TextBlock Text="Cyan to pink" Style="{StaticResource RowCaption}" />
                                    <Border Height="8" CornerRadius="4" Margin="0,9,0,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00FFFF" Offset="0" /><GradientStop Color="#0A84FF" Offset="0.33" /><GradientStop Color="#A855F7" Offset="0.66" /><GradientStop Color="#FF2D55" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="LightGradient" Tag="Sunset" IsChecked="{Binding ActiveLightingSummary, Converter={StaticResource EffectMatch}, ConverterParameter=Sunset, Mode=OneWay}" Click="ApplyLightingTheme_Click" Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="Sunset" Style="{StaticResource RowTitle}" Margin="0,0,22,0" />
                                    <TextBlock Text="Violet to gold" Style="{StaticResource RowCaption}" />
                                    <Border Height="8" CornerRadius="4" Margin="0,9,0,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#A855F7" Offset="0" /><GradientStop Color="#FF2D55" Offset="0.33" /><GradientStop Color="#FF6414" Offset="0.66" /><GradientStop Color="#FFC80A" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="LightGradient" Tag="Ocean" IsChecked="{Binding ActiveLightingSummary, Converter={StaticResource EffectMatch}, ConverterParameter=Ocean, Mode=OneWay}" Click="ApplyLightingTheme_Click" Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="Ocean" Style="{StaticResource RowTitle}" Margin="0,0,22,0" />
                                    <TextBlock Text="Deep blue to mint" Style="{StaticResource RowCaption}" />
                                    <Border Height="8" CornerRadius="4" Margin="0,9,0,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#003CFF" Offset="0" /><GradientStop Color="#0A84FF" Offset="0.33" /><GradientStop Color="#00D2FF" Offset="0.66" /><GradientStop Color="#30D158" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="LightGradient" Tag="FireIce" IsChecked="{Binding ActiveLightingSummary, Converter={StaticResource EffectMatch}, ConverterParameter=FireIce, Mode=OneWay}" Click="ApplyLightingTheme_Click" Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="Fire and ice" Style="{StaticResource RowTitle}" Margin="0,0,22,0" />
                                    <TextBlock Text="Ice blue to red" Style="{StaticResource RowCaption}" />
                                    <Border Height="8" CornerRadius="4" Margin="0,9,0,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00FFFF" Offset="0" /><GradientStop Color="#0A84FF" Offset="0.33" /><GradientStop Color="#FF8C00" Offset="0.66" /><GradientStop Color="#FF1E1E" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="LightGradient" Tag="Matrix" IsChecked="{Binding ActiveLightingSummary, Converter={StaticResource EffectMatch}, ConverterParameter=Matrix, Mode=OneWay}" Click="ApplyLightingTheme_Click" Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="Emerald" Style="{StaticResource RowTitle}" Margin="0,0,22,0" />
                                    <TextBlock Text="Dark to bright green" Style="{StaticResource RowCaption}" />
                                    <Border Height="8" CornerRadius="4" Margin="0,9,0,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#105020" Offset="0" /><GradientStop Color="#20A040" Offset="0.33" /><GradientStop Color="#30D158" Offset="0.66" /><GradientStop Color="#60FF80" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="LightGradient" Tag="Monochrome" IsChecked="{Binding ActiveLightingSummary, Converter={StaticResource EffectMatch}, ConverterParameter=Monochrome, Mode=OneWay}" Click="ApplyLightingTheme_Click" Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="Silver" Style="{StaticResource RowTitle}" Margin="0,0,22,0" />
                                    <TextBlock Text="Gray to white" Style="{StaticResource RowCaption}" />
                                    <Border Height="8" CornerRadius="4" Margin="0,9,0,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#50505A" Offset="0" /><GradientStop Color="#9090A0" Offset="0.33" /><GradientStop Color="#D0D0E0" Offset="0.66" /><GradientStop Color="#FFFFFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                        </c:AdaptiveColumns>
                    </StackPanel>

                    <!-- ANIMATION -->
                    <StackPanel Visibility="{Binding LightingAnimationsTabVisibility}" Margin="14,14,14,14">
                        <c:AdaptiveColumns MinColumnWidth="200" Gap="10">
                            <RadioButton GroupName="LightAnimation" Tag="VoiceReactive" IsChecked="{Binding ActiveLightingSummary, Converter={StaticResource EffectMatch}, ConverterParameter=VoiceReactive, Mode=OneWay}" Click="LightingEffect_Click" Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="Voice meter" Style="{StaticResource RowTitle}" Margin="0,0,22,0" />
                                    <TextBlock Text="Lights rise as you talk." Style="{StaticResource RowCaption}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="LightAnimation" Tag="SpectrumSweep" IsChecked="{Binding ActiveLightingSummary, Converter={StaticResource EffectMatch}, ConverterParameter=SpectrumSweep, Mode=OneWay}" Click="LightingEffect_Click" Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="Rainbow sweep" Style="{StaticResource RowTitle}" Margin="0,0,22,0" />
                                    <TextBlock Text="A rainbow glides across." Style="{StaticResource RowCaption}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="LightAnimation" Tag="Breathing" IsChecked="{Binding ActiveLightingSummary, Converter={StaticResource EffectMatch}, ConverterParameter=Breathing, Mode=OneWay}" Click="LightingEffect_Click" Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="Breathing" Style="{StaticResource RowTitle}" Margin="0,0,22,0" />
                                    <TextBlock Text="Slow fade in your color." Style="{StaticResource RowCaption}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="LightAnimation" Tag="RetroRainbow" IsChecked="{Binding ActiveLightingSummary, Converter={StaticResource EffectMatch}, ConverterParameter=RetroRainbow, Mode=OneWay}" Click="LightingEffect_Click" Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="Retro rainbow" Style="{StaticResource RowTitle}" Margin="0,0,22,0" />
                                    <TextBlock Text="Classic color cycle." Style="{StaticResource RowCaption}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="LightAnimation" Tag="WaterfallDown" IsChecked="{Binding ActiveLightingSummary, Converter={StaticResource EffectMatch}, ConverterParameter=WaterfallDown, Mode=OneWay}" Click="LightingEffect_Click" Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="Waterfall down" Style="{StaticResource RowTitle}" Margin="0,0,22,0" />
                                    <TextBlock Text="Color flows downward." Style="{StaticResource RowCaption}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="LightAnimation" Tag="WaterfallUp" IsChecked="{Binding ActiveLightingSummary, Converter={StaticResource EffectMatch}, ConverterParameter=WaterfallUp, Mode=OneWay}" Click="LightingEffect_Click" Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="Waterfall up" Style="{StaticResource RowTitle}" Margin="0,0,22,0" />
                                    <TextBlock Text="Color flows upward." Style="{StaticResource RowCaption}" />
                                </StackPanel>
                            </RadioButton>
                        </c:AdaptiveColumns>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
