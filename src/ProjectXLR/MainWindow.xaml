<Window x:Class="ProjectXLR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ProjectXLR.Views"
        xmlns:c="clr-namespace:ProjectXLR.Controls"
        Title="XLR Studio"
        Icon="Assets/AppIcon.ico"
        Width="1240" Height="860"
        MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SizeChanged="Window_SizeChanged"
        Closed="Window_Closed">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: full labels when there's room, icons only when the window is narrow -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="12,14">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="216" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompactWindowMode}" Value="True">
                            <Setter Property="Width" Value="64" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,20">
                    <Image Source="Assets/AppIcon.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="XLR Studio" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding IsCompactWindowMode, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>

                <!-- Device and profile sit at the bottom, out of the way but always visible -->
                <StackPanel DockPanel.Dock="Bottom">
                    <StackPanel Visibility="{Binding IsCompactWindowMode, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="Profile" Style="{StaticResource RowCaption}" Margin="4,0,0,5" />
                        <ComboBox ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfileName, Mode=TwoWay}" ToolTip="Your saved setups. Switching loads that setup onto the GoXLR." Margin="0,0,0,14" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,2" ToolTip="{Binding ConnectionStatusText}">
                        <Ellipse x:Name="ConnectionDot" Width="9" Height="9" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource RedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource GreenBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <StackPanel Margin="9,0,0,0" Visibility="{Binding IsCompactWindowMode, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="GoXLR not connected" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Text" Value="GoXLR Mini connected" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <Grid Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVis}}" Margin="0,9,0,0">
                        <Button Content="Reconnect" Click="Reconnect_Click" Style="{StaticResource Btn}"
                                Visibility="{Binding IsCompactWindowMode, Converter={StaticResource InverseBoolToVis}}" />
                        <Button Content="↻" Click="Reconnect_Click" Style="{StaticResource BtnStep}" HorizontalAlignment="Left" ToolTip="Reconnect to the GoXLR"
                                Visibility="{Binding IsCompactWindowMode, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </StackPanel>

                <StackPanel>
                    <RadioButton Content="Voice" GroupName="Nav" Tag="{StaticResource SfMic}" IsChecked="{Binding IsVoiceTab, Mode=TwoWay}" Style="{StaticResource NavItem}" ToolTip="Voice" />
                    <RadioButton Content="Mixer" GroupName="Nav" Tag="{StaticResource SfSliders}" IsChecked="{Binding IsMixerTab, Mode=TwoWay}" Style="{StaticResource NavItem}" ToolTip="Mixer" />
                    <RadioButton Content="Routing" GroupName="Nav" Tag="{StaticResource SfCable}" IsChecked="{Binding IsRoutingTab, Mode=TwoWay}" Style="{StaticResource NavItem}" ToolTip="Routing" />
                    <RadioButton Content="Lighting" GroupName="Nav" Tag="{StaticResource IconLight}" IsChecked="{Binding IsLightingTab, Mode=TwoWay}" Style="{StaticResource NavItem}" ToolTip="Lighting" />
                    <RadioButton Content="Settings" GroupName="Nav" Tag="{StaticResource SfGear}" IsChecked="{Binding IsSettingsTab, Mode=TwoWay}" Style="{StaticResource NavItem}" ToolTip="Settings" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Live voice meter, on every page. Color appears only when the level reaches that range. -->
            <Border Grid.Row="0" Padding="24,14,24,12" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Width="176" Margin="0,0,16,0">
                        <TextBlock Text="{Binding ObsLevelStatusText}" FontSize="13.5" FontWeight="SemiBold" Foreground="{Binding ObsMeterStatusBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ObsLevelText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Border Height="14" Background="{StaticResource InsetBrush}" CornerRadius="7" ClipToBounds="True"
                                ToolTip="Your microphone level. Aim for your normal speaking voice to land inside the lighter Ideal band.">
                            <Grid>
                                <!-- Ideal speaking band: -30 dB to -6 dB on a -60 to 0 dB scale -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30*" />
                                        <ColumnDefinition Width="24*" />
                                        <ColumnDefinition Width="6*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="1" Background="#26262B" />
                                </Grid>
                                <!-- Sounds left of this line are silenced by the noise gate -->
                                <Grid Visibility="{Binding GateZoneVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding GateCutoffActiveWidth}" />
                                        <ColumnDefinition Width="{Binding GateCutoffRemainingWidth}" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" BorderBrush="{StaticResource AmberBrush}" BorderThickness="0,0,2,0" Background="#1AFFD60A"
                                            ToolTip="{Binding GateCutoffLabel, StringFormat=Noise gate ({0}): anything quieter than this line is silenced.}" />
                                </Grid>
                                <!-- Sounds right of this line are evened out by the volume leveler -->
                                <Grid Visibility="{Binding CompressorZoneVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding CompressorPreWidth}" />
                                        <ColumnDefinition Width="{Binding CompressorActiveWidth}" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="1" BorderBrush="{StaticResource TextSecondaryBrush}" BorderThickness="2,0,0,0"
                                            ToolTip="{Binding CompressorMeterLabel, StringFormat=Volume leveler ({0}): anything louder than this line is smoothed.}" />
                                </Grid>
                                <Grid IsHitTestVisible="False">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding ObsMeterActiveWidth}" />
                                        <ColumnDefinition Width="{Binding ObsMeterRemainingWidth}" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Height="8" VerticalAlignment="Center" Background="{Binding ObsMeterBrush}" CornerRadius="4" Margin="3,0,0,0" />
                                </Grid>
                                <Grid IsHitTestVisible="False">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding ObsPeakHoldActiveWidth}" />
                                        <ColumnDefinition Width="{Binding ObsPeakHoldRemainingWidth}" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="2" Background="White" HorizontalAlignment="Right" />
                                </Grid>
                            </Grid>
                        </Border>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30*" />
                                <ColumnDefinition Width="24*" />
                                <ColumnDefinition Width="6*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Too quiet" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Ideal" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Loud" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    <CheckBox Grid.Column="2" IsChecked="{Binding IsMicMuted, Mode=TwoWay}" Style="{StaticResource MuteToggle}" Margin="18,0,0,16"
                              ToolTip="Mute your microphone. Stays in sync with the Cough button on the GoXLR." />
                </Grid>
            </Border>

            <!-- Live coaching: one tip at a time, only for a problem that keeps happening -->
            <Border Grid.Row="1" Style="{StaticResource Notice}" Margin="24,12,24,0" Visibility="{Binding HasCoachHint, Converter={StaticResource BoolToVis}}">
                <c:AdaptiveRow>
                    <StackPanel>
                        <TextBlock Text="{Binding CoachTitle}" Style="{StaticResource RowTitle}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CoachMessage}" Style="{StaticResource RowCaption}" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Not now" Click="CoachDismiss_Click" Style="{StaticResource Btn}" Margin="0,0,8,0" />
                        <Button Content="{Binding CoachFixLabel}" Click="CoachFix_Click" Style="{StaticResource BtnAccent}" />
                    </StackPanel>
                </c:AdaptiveRow>
            </Border>

            <!-- Pages -->
            <Grid Grid.Row="2">
                <views:VoicePage Visibility="{Binding VoiceTabVisibility}" />
                <views:MixerPage Visibility="{Binding MixerTabVisibility}" />
                <views:RoutingPage Visibility="{Binding RoutingTabVisibility}" />
                <views:LightingPage Visibility="{Binding LightingTabVisibility}" />
                <views:SettingsPage Visibility="{Binding SettingsTabVisibility}" />

                <!-- Check my voice: covers the page but leaves the live meter visible above it -->
                <Grid Background="#CC000000" Visibility="{Binding IsVoiceCheckOpen, Converter={StaticResource BoolToVis}}">
                    <Border MaxWidth="560" Margin="24" Background="{StaticResource CardBrush}" CornerRadius="16" Padding="26,22" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{Binding VoiceCheckStepText}" Style="{StaticResource RowCaption}" Margin="0,0,0,4"
                                           Visibility="{Binding IsVoiceCheckRecording, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding VoiceCheckTitle}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding VoiceCheckInstruction}" Style="{StaticResource PageSubtitle}" Margin="0,6,0,0"
                                           Visibility="{Binding IsVoiceCheckResult, Converter={StaticResource InverseBoolToVis}}" />

                                <!-- Intro -->
                                <StackPanel Margin="0,20,0,0" Visibility="{Binding IsVoiceCheckIntro, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Sit where you normally sit, with your mic where you normally keep it." Style="{StaticResource RowCaption}" />
                                    <Grid Margin="0,18,0,0">
                                        <Button Content="Cancel" Click="VoiceCheckClose_Click" Style="{StaticResource Btn}" HorizontalAlignment="Left" />
                                        <Button Content="Start" Click="VoiceCheckStart_Click" Style="{StaticResource BtnAccent}" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>

                                <!-- Recording -->
                                <StackPanel Margin="0,16,0,0" Visibility="{Binding IsVoiceCheckRecording, Converter={StaticResource BoolToVis}}">
                                    <Border Background="{StaticResource InsetBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,16"
                                            Visibility="{Binding HasVoiceCheckReadAloud, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding VoiceCheckReadAloud}" FontSize="15" LineHeight="22" TextWrapping="Wrap" />
                                    </Border>
                                    <ProgressBar Value="{Binding VoiceCheckProgress, Mode=OneWay}" Maximum="100" Height="6" Background="{StaticResource InsetBrush}" Foreground="{StaticResource AccentBrush}" BorderThickness="0" />
                                    <Button Content="Cancel" Click="VoiceCheckClose_Click" Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                                </StackPanel>

                                <!-- Result -->
                                <StackPanel Margin="0,14,0,0" Visibility="{Binding IsVoiceCheckResult, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl ItemsSource="{Binding VoiceCheckChanges}" Visibility="{Binding HasVoiceCheckChanges, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource RowTitle}" LineHeight="20" Margin="0,0,0,10" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding VoiceCheckWarnings}" Visibility="{Binding HasVoiceCheckWarnings, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Notice}" Padding="12,9" Margin="0,0,0,10">
                                                    <TextBlock Text="{Binding}" Style="{StaticResource RowCaption}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Things a level reading can't judge -->
                                    <StackPanel Visibility="{Binding VoiceCheckSucceeded, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                                        <TextBlock Text="Now listen" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                                        <TextBlock Text="Levels can't tell how you sound, so check by ear. Start the test and speak softly." Style="{StaticResource RowCaption}" />
                                        <Button Content="{Binding MicCheckButtonText}" Click="VoiceCheckListen_Click" Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="0,10,0,12" />
                                        <c:AdaptiveRow Margin="0,0,0,10" Visibility="{Binding IsToneMuffled, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="Sound muffled?" Style="{StaticResource RowTitle}" />
                                                <TextBlock Text="Your Tone setting is cutting a lot of treble, which makes soft words harder to understand." Style="{StaticResource RowCaption}" />
                                            </StackPanel>
                                            <Button Content="Use Natural tone" Click="VoiceCheckToneNatural_Click" Style="{StaticResource Btn}" />
                                        </c:AdaptiveRow>
                                        <c:AdaptiveRow Margin="0,0,0,10" Visibility="{Binding CanOfferStrongestAi, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="Still hear your keyboard?" Style="{StaticResource RowTitle}" />
                                                <TextBlock Text="Only AI noise removal can remove keys while you talk. Strongest removes the most." Style="{StaticResource RowCaption}" />
                                            </StackPanel>
                                            <Button Content="Use Strongest" Click="VoiceCheckAiStrongest_Click" Style="{StaticResource Btn}" />
                                        </c:AdaptiveRow>
                                        <c:AdaptiveRow Margin="0,0,0,10" Visibility="{Binding CanOfferGentleAi, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="Soft words vanishing?" Style="{StaticResource RowTitle}" />
                                                <TextBlock Text="AI noise removal can mistake them for noise. Gentle removes less." Style="{StaticResource RowCaption}" />
                                            </StackPanel>
                                            <Button Content="Use Gentle" Click="VoiceCheckAiGentle_Click" Style="{StaticResource Btn}" />
                                        </c:AdaptiveRow>
                                    </StackPanel>

                                    <Grid Margin="0,10,0,0">
                                        <Button Content="Undo changes" Click="VoiceCheckUndo_Click" Style="{StaticResource Btn}" HorizontalAlignment="Left"
                                                Visibility="{Binding CanUndoVoiceCheck, Converter={StaticResource BoolToVis}}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Try again" Click="VoiceCheckStart_Click" Style="{StaticResource Btn}" Margin="0,0,8,0"
                                                    Visibility="{Binding VoiceCheckFailed, Converter={StaticResource BoolToVis}}" />
                                            <Button Content="Done" Click="VoiceCheckClose_Click" Style="{StaticResource BtnAccent}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Last-action notification -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,16" Background="#2A2A2F" BorderBrush="#3C3C43" BorderThickness="1"
                        CornerRadius="16" Padding="14,7" MaxWidth="640" IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusBannerMessage}" Value="Ready">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusBannerMessage}" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                </Border>
            </Grid>
        </Grid>

        <!-- Quick setup, opened from Settings -->
        <Grid Grid.ColumnSpan="2" Background="#CC000000" Visibility="{Binding IsQuickStartWizardOpen, Converter={StaticResource BoolToVis}}">
            <Border MaxWidth="560" Margin="24" Background="{StaticResource CardBrush}" CornerRadius="16" Padding="26,22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding QuickStartStepTitle}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding QuickStartStepDescription}" Style="{StaticResource PageSubtitle}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Close" Click="CloseQuickStart_Click" Style="{StaticResource Btn}" VerticalAlignment="Top" Margin="12,0,0,0" />
                    </Grid>

                    <StackPanel Margin="0,0,0,22" Visibility="{Binding IsQuickStartStep1, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="What kind of microphone do you have?" Style="{StaticResource RowTitle}" Margin="0,0,0,8" />
                        <Border Style="{StaticResource SegmentedTrack}" HorizontalAlignment="Stretch" Margin="0,0,0,18">
                            <UniformGrid Rows="1">
                                <RadioButton Content="Dynamic" GroupName="WizMicType" IsChecked="{Binding IsDynamicMic, Mode=TwoWay}" Style="{StaticResource Segment}" />
                                <RadioButton Content="Condenser" GroupName="WizMicType" IsChecked="{Binding IsCondenserMic, Mode=TwoWay}" Style="{StaticResource Segment}" />
                            </UniformGrid>
                        </Border>
                        <TextBlock Text="Pick a starting mic level" Style="{StaticResource RowTitle}" Margin="0,0,0,8" />
                        <UniformGrid Rows="1">
                            <Button Content="35 dB" Tag="35" Click="MicGainPreset_Click" Style="{StaticResource Btn}" Margin="0,0,6,0" ToolTip="For condenser mics" />
                            <Button Content="50 dB" Tag="50" Click="MicGainPreset_Click" Style="{StaticResource Btn}" Margin="0,0,6,0" ToolTip="For most dynamic mics" />
                            <Button Content="60 dB" Tag="60" Click="MicGainPreset_Click" Style="{StaticResource Btn}" Margin="0,0,6,0" ToolTip="For quieter dynamic mics" />
                            <Button Content="65 dB" Tag="65" Click="MicGainPreset_Click" Style="{StaticResource Btn}" ToolTip="For very quiet mics like the SM7B" />
                        </UniformGrid>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,22" Visibility="{Binding IsQuickStartStep2, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Where are your headphones plugged in?" Style="{StaticResource RowTitle}" Margin="0,0,0,8" />
                        <ComboBox ItemsSource="{Binding PlaybackDevices}" SelectedItem="{Binding SelectedPlaybackDevice, Mode=TwoWay}" DisplayMemberPath="DisplayName" Margin="0,0,0,16" />
                        <Grid>
                            <TextBlock Text="Hear my own voice in my headphones" Style="{StaticResource RowTitle}" Margin="0,0,52,0" />
                            <CheckBox IsChecked="{Binding SidetoneEnabled, Mode=TwoWay}" Style="{StaticResource Switch}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,22" Visibility="{Binding IsQuickStartStep3, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <TextBlock Text="Reduce background noise on the GoXLR" Style="{StaticResource RowTitle}" Margin="0,0,52,0" />
                            <CheckBox IsChecked="{Binding StudioNoiseSuppressionEnabled, Mode=TwoWay}" Style="{StaticResource Switch}" />
                        </Grid>
                        <TextBlock Text="The GoXLR handles noise, tone and volume itself, so you can turn off noise suppression in Discord and in games." Style="{StaticResource RowCaption}" Margin="0,8,0,0" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,22" Visibility="{Binding IsQuickStartStep4, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Keep music off my stream" Style="{StaticResource RowTitle}" Margin="0,0,52,0" />
                            <CheckBox IsChecked="{Binding IsMusicMutedOnStream, Mode=TwoWay}" Style="{StaticResource Switch}" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Keep voice chat off my stream" Style="{StaticResource RowTitle}" Margin="0,0,52,0" />
                            <CheckBox IsChecked="{Binding IsChatPrivateInHeadset, Mode=TwoWay}" Style="{StaticResource Switch}" />
                        </Grid>
                    </StackPanel>

                    <Grid>
                        <Button Content="Back" Click="QuickStartPrev_Click" Style="{StaticResource Btn}" HorizontalAlignment="Left" />
                        <Button Content="Next" Click="QuickStartNext_Click" Style="{StaticResource BtnAccent}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
