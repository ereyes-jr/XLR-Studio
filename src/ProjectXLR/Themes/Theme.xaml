<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:ProjectXLR.Controls">

    <!-- Design rules: one accent color, semantic colors only for live state, no ALL-CAPS badges,
         no emoji, nothing smaller than 12px, every page built from grouped cards of label + control rows. -->

